{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": { "includes": ["**", "!**/node_modules", "!**/dist", "!pnpm-lock.yaml"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all" } },
  "linter": {
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "error", "noConsole": "error" },
      "style": { "noNonNullAssertion": "error", "useImportType": "error" }
    }
  }
}
